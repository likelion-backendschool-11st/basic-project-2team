# 이 파일을 .env 로 복사해서 사용합니다. (.env 는 커밋하지 않습니다)
PORT=8080

# 프론트 개발 서버 주소 (쉼표로 여러 개 지정 가능)
CORS_ORIGIN=http://localhost:5173

# db/create-app-user.sql 로 만든 로컬 계정
DB_HOST=localhost
DB_PORT=3306
DB_USER=begg
DB_PASSWORD=begg
DB_NAME=beggdb

BCRYPT_ROUNDS=10

# JWT 서명 키 (운영 환경에서는 반드시 길고 무작위한 값으로 변경)
JWT_SECRET=change-me-to-a-long-random-string
# Access Token 유효 시간(초)
ACCESS_TOKEN_TTL_SECONDS=7200
# Refresh Token 유효 기간(일) — 로그인 상태 유지 미선택 / 선택
REFRESH_TOKEN_TTL_DAYS=1
REMEMBER_ME_TTL_DAYS=14

# 업로드 파일(프로필 이미지) 저장 폴더. 비워 두면 backend/uploads
# UPLOAD_DIR=

# Cloudflare R2 (프로필 이미지 저장). 아래 다섯 값이 모두 있어야 켜지고, 비워 두면 위의 UPLOAD_DIR 폴더에 저장합니다.
# 접근 키는 서버에만 두고 절대 커밋하거나 프론트에 넣지 않습니다. (Account ID 만 넣으면 엔드포인트는 코드가 만듭니다)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# 이미지를 불러올 공개 주소 (커스텀 도메인 또는 r2.dev 주소)
# R2_PUBLIC_BASE_URL=https://cdn.example.com
# 버킷 안에서 프로필 이미지를 모아 둘 폴더 (기본 avatars/)
# R2_AVATAR_PREFIX=avatars/
