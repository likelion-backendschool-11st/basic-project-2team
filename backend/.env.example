# 이 파일을 .env 로 복사해서 사용합니다. (.env 는 커밋하지 않습니다)
PORT=8080

# 프론트 개발 서버 주소 (쉼표로 여러 개 지정 가능)
CORS_ORIGIN=http://localhost:5173

# db/create-app-user.sql 로 만든 로컬 계정
DB_HOST=localhost
DB_PORT=3306
DB_USER=begg
DB_PASSWORD=begg
DB_NAME=beggdb

BCRYPT_ROUNDS=10

# JWT 서명 키 (운영 환경에서는 반드시 길고 무작위한 값으로 변경)
JWT_SECRET=change-me-to-a-long-random-string
# Access Token 유효 시간(초)
ACCESS_TOKEN_TTL_SECONDS=1800
# Refresh Token 유효 기간(일) — 로그인 상태 유지 미선택 / 선택
REFRESH_TOKEN_TTL_DAYS=1
REMEMBER_ME_TTL_DAYS=14

# 메일 발송 (이메일 인증코드). SMTP_HOST 를 비워두면 메일 대신 서버 콘솔에 인증코드를 출력합니다.
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=계정@gmail.com, SMTP_PASSWORD=앱 비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=587
# 465 포트(SSL)를 쓰면 true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OurParty <no-reply@ourparty.local>
