# 이 파일을 .env 로 복사해서 사용합니다. (.env 는 커밋하지 않습니다)
PORT=8080

# 프론트 개발 서버 주소 (쉼표로 여러 개 지정 가능)
CORS_ORIGIN=http://localhost:5173

# db/create-app-user.sql 로 만든 로컬 계정
DB_HOST=localhost
DB_PORT=3306
DB_USER=begg
DB_PASSWORD=begg
DB_NAME=beggdb

BCRYPT_ROUNDS=10

# JWT 서명 키 (운영 환경에서는 반드시 길고 무작위한 값으로 변경)
JWT_SECRET=change-me-to-a-long-random-string
# Access Token 유효 시간(초)
ACCESS_TOKEN_TTL_SECONDS=1800
# Refresh Token 유효 기간(일) — 로그인 상태 유지 미선택 / 선택
REFRESH_TOKEN_TTL_DAYS=1
REMEMBER_ME_TTL_DAYS=14
